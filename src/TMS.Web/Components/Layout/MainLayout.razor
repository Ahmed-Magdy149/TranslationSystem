@inherits LayoutComponentBase
@inject NavigationManager Navigation

<Layout Style="min-height: 100vh; background: #f8fafc;">
    <Sider Theme="@SiderTheme.Dark"
           Collapsible
           CollapsedWidth="80"
           Style="background: #ffffff; border-right: 1px solid #e8e8e8;">
        <div class="sidebar-brand">
            <Avatar Shape="@AvatarShape.Square" Size="@AvatarSize.Large" Style="background: #1a73e8; border-radius: 10px;">
                <Icon Type="global" Style="font-size: 22px; color: white;" />
            </Avatar>
            @if (!collapsed)
            {
                <span class="sidebar-brand-title">The Translation Gate</span>
            }
        </div>
        <div class="sidebar-nav-section">
            @if (!collapsed)
            {
                <span class="sidebar-section-label">NAVIGATION</span>
            }
            <Menu Theme="@MenuTheme.Light"
                  Mode="@MenuMode.Inline"
                  DefaultSelectedKeys="@(new[] { GetMenuKey() })"
                  InlineCollapsed="collapsed"
                  Class="sidebar-menu">
                <MenuItem Key="dashboard" RouterLink="/dashboard">
                    <Icon Type="dashboard" />
                    <span>Dashboard</span>
                </MenuItem>
                <MenuItem Key="tasks" RouterLink="/tasks">
                    <Icon Type="file-text" />
                    <span>Tasks</span>
                </MenuItem>
                <MenuItem Key="translators" RouterLink="/translators">
                    <Icon Type="team" />
                    <span>Translators</span>
                </MenuItem>
                <MenuItem Key="users" RouterLink="/users">
                    <Icon Type="user" />
                    <span>Users</span>
                </MenuItem>
                <MenuItem Key="reviews" RouterLink="/reviews">
                    <Icon Type="star" />
                    <span>Reviews</span>
                </MenuItem>
            </Menu>
        </div>
        <div class="sidebar-account-section">
            @if (!collapsed)
            {
                <span class="sidebar-section-label">ACCOUNT</span>
            }
            <Menu Theme="@MenuTheme.Light"
                  Mode="@MenuMode.Inline"
                  InlineCollapsed="collapsed"
                  Class="sidebar-menu">
                <MenuItem Key="profile">
                    <Icon Type="profile" />
                    <span>Profile</span>
                </MenuItem>
                <MenuItem Key="settings">
                    <Icon Type="setting" />
                    <span>Settings</span>
                </MenuItem>
            </Menu>
        </div>
        <div class="sidebar-footer">
            <Avatar Style="background: #1a73e8;">SR</Avatar>
            @if (!collapsed)
            {
                <div class="sidebar-footer-info">
                    <span class="sidebar-footer-name">Sarah Reed</span>
                    <span class="sidebar-footer-role">Project Manager</span>
                </div>
            }
        </div>
    </Sider>
    <Layout Style="background: #f8fafc;">
        <Header Class="app-header" Style="background: white; padding: 0 24px; height: 64px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e8e8e8;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <Button Type="@ButtonType.Text" OnClick="ToggleCollapse" Style="padding: 4px 8px;">
                    <Icon Type="@GetCollapseIcon()" Style="font-size: 16px; color: #595959;" />
                </Button>
                <div>
                    <span style="font-size: 20px; font-weight: 600; color: #1a1a1a; display: block;">@GetPageTitle()</span>
                    <span style="font-size: 13px; color: #8c8c8c;">@GetGreeting()</span>
                </div>
            </div>
            <div style="display: flex; align-items: center; gap: 12px;">
                <Input TValue="string"
                       Placeholder="Search anything..."
                       Size="@InputSize.Small"
                       Style="width: 240px; border-radius: 20px; background: #f5f7fa;" />
                <Button Type="@ButtonType.Text" Size="@ButtonSize.Small" Style="color: #595959;">
                    <Icon Type="reload" />
                </Button>
                <Badge Count="3" Style="cursor: pointer;">
                    <Button Type="@ButtonType.Text" Icon="bell" Size="@ButtonSize.Small" Style="color: #595959;" />
                </Badge>
                <Badge Dot Style="cursor: pointer;">
                    <Button Type="@ButtonType.Text" Icon="message" Size="@ButtonSize.Small" Style="color: #595959;" />
                </Badge>
                <Dropdown>
                    <Overlay>
                        <Menu>
                            <MenuItem Key="profile" Icon="user">Profile</MenuItem>
                            <MenuItem Key="settings" Icon="setting">Settings</MenuItem>
                            <MenuDivider />
                            <MenuItem Key="logout" Icon="logout" OnClick="Logout">Logout</MenuItem>
                        </Menu>
                    </Overlay>
                    <ChildContent>
                        <div style="display: flex; align-items: center; gap: 8px; cursor: pointer; padding: 4px 8px; border-radius: 6px;">
                            <Avatar Style="background: #1a73e8; font-weight: 500;">SR</Avatar>
                            <span style="font-weight: 500; font-size: 14px; color: #262626;">Sarah</span>
                            <Icon Type="down" Style="font-size: 10px; color: #8c8c8c;" />
                        </div>
                    </ChildContent>
                </Dropdown>
            </div>
        </Header>
        <Content Style="padding: 24px; background: #f8fafc; min-height: calc(100vh - 64px);">
            @Body
        </Content>
    </Layout>
</Layout>

<div id="blazor-error-ui" data-nosnippet style="display:none;">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x1F5D9;</span>
</div>

@code {
    private bool collapsed = false;

    private void ToggleCollapse()
    {
        collapsed = !collapsed;
    }

    private string GetCollapseIcon() => collapsed ? "menu-unfold" : "menu-fold";

    private string GetMenuKey()
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        return uri switch
        {
            "" or "dashboard" => "dashboard",
            "tasks" => "tasks",
            "translators" => "translators",
            "users" => "users",
            "reviews" => "reviews",
            _ => "dashboard"
        };
    }

    private string GetPageTitle()
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        return uri switch
        {
            "" or "dashboard" => "Dashboard",
            "tasks" => "Tasks",
            "translators" => "Translators",
            "users" => "Users",
            "reviews" => "Reviews",
            _ => "Dashboard"
        };
    }

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        var greeting = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
        return $"{greeting}, Sarah";
    }

    private void Logout()
    {
        Navigation.NavigateTo("/login");
    }
}
