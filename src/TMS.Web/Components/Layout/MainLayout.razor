@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<Layout Style="min-height: 100vh; background: #f8fafc;">
    <Sider Theme="@SiderTheme.Dark"
           Collapsible
           CollapsedWidth="80"
           Style="background: #1e293b; border-right: 1px solid #334155;">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                @if (!collapsed)
                {
                    <Avatar Shape="@AvatarShape.Square" Size="@AvatarSize.Large" Style="background: #3b82f6; border-radius: 10px;">
                        <Icon Type="global" Style="font-size: 22px; color: white;" />
                    </Avatar>
                    <span class="sidebar-brand-title">The Translation Gate</span>
                }
                else
                {
                    <Avatar Shape="@AvatarShape.Square" Size="@AvatarSize.Default" Style="background: #3b82f6; border-radius: 8px;">
                        <Icon Type="global" Style="font-size: 18px; color: white;" />
                    </Avatar>
                }
            </div>
            <Button Type="@ButtonType.Text" OnClick="ToggleCollapse" Class="collapse-btn">
                <Icon Type="@GetCollapseIcon()" Style="font-size: 16px; color: #94a3b8;" />
            </Button>
        </div>

        @if (!collapsed)
        {
            <div class="role-toggle-container">
                <div class="role-button @(currentUserRole == UserRole.Translator ? "active-role" : "")" @onclick="SetRoleToTranslator">
                    <Icon Type="user" />
                    <span>You</span>
                </div>
                <div class="role-button @(currentUserRole == UserRole.Manager ? "active-role" : "")" @onclick="SetRoleToManager">
                    <Icon Type="team" />
                    <span>Manager</span>
                </div>
            </div>
        }
        else
        {
            <div class="nav-spacer"></div>
        }

        <div class="sidebar-menu-container">
            @if (currentUserRole == UserRole.Manager)
            {
                <Menu Mode="@MenuMode.Inline"
                      Theme="@MenuTheme.Dark"
                      DefaultSelectedKeys="@(new[] { GetMenuKey() })"
                      InlineCollapsed="collapsed"
                      Class="sidebar-menu-dark">
                    <MenuItem Key="dashboard" Icon="dashboard" RouterLink="/dashboard">
                        <span>Dashboard</span>
                    </MenuItem>
                    <MenuItem Key="tasks" Icon="file-text" RouterLink="/tasks">
                        <span>Tasks</span>
                    </MenuItem>
                    <MenuItem Key="translators" Icon="team" RouterLink="/translators">
                        <span>Translators</span>
                    </MenuItem>
                    <MenuItem Key="users" Icon="user" RouterLink="/users">
                        <span>Users</span>
                    </MenuItem>
                    <MenuItem Key="reviews" Icon="star" RouterLink="/reviews">
                        <span>Reviews</span>
                    </MenuItem>
                    <SubMenu Key="settings" TitleTemplate="@settingsTitleTemplate">
                        <MenuItemGroup Key="account" Title="Account">
                            <MenuItem Key="profile" OnClick="@(() => NavigateTo("/profile"))">
                                <Icon Type="profile" />
                                <span>Personal information</span>
                            </MenuItem>
                            <MenuItem Key="password" OnClick="@(() => NavigateTo("/change-password"))">
                                <Icon Type="lock" />
                                <span>Change password</span>
                            </MenuItem>
                            <MenuItem Key="notifications" OnClick="@(() => NavigateTo("/notifications"))">
                                <Icon Type="bell" />
                                <span>Notification settings</span>
                            </MenuItem>
                        </MenuItemGroup>
                    </SubMenu>
                </Menu>
            }
            else
            {
                <Menu Mode="@MenuMode.Inline"
                      Theme="@MenuTheme.Dark"
                      DefaultSelectedKeys="@(new[] { GetMenuKey() })"
                      InlineCollapsed="collapsed"
                      Class="sidebar-menu-dark">
                    <MenuItem Key="dashboard" Icon="dashboard" RouterLink="/dashboard">
                        <span>Dashboard</span>
                    </MenuItem>
                    <MenuItem Key="my-tasks" Icon="file-text" RouterLink="/my-tasks">
                        <span>My Tasks</span>
                    </MenuItem>
                    <MenuItem Key="my-reviews" Icon="star" RouterLink="/my-reviews">
                        <span>My Reviews</span>
                    </MenuItem>
                    <MenuItem Key="users" Icon="user" RouterLink="/users">
                        <span>Users</span>
                    </MenuItem>
                    <MenuItem Key="calendar" Icon="calendar" RouterLink="/calendar">
                        <span>Calendar</span>
                    </MenuItem>
                    <SubMenu Key="settings" TitleTemplate="@settingsTitleTemplate">
                        <MenuItemGroup Key="account" Title="Account">
                            <MenuItem Key="profile" OnClick="@(() => NavigateTo("/profile"))">
                                <Icon Type="profile" />
                                <span>Personal information</span>
                            </MenuItem>
                            <MenuItem Key="password" OnClick="@(() => NavigateTo("/change-password"))">
                                <Icon Type="lock" />
                                <span>Change password</span>
                            </MenuItem>
                            <MenuItem Key="notifications" OnClick="@(() => NavigateTo("/notifications"))">
                                <Icon Type="bell" />
                                <span>Notification settings</span>
                            </MenuItem>
                        </MenuItemGroup>
                    </SubMenu>
                </Menu>
            }
        </div>

        <div class="sidebar-footer-dark">
            @if (!collapsed)
            {
                <div class="logout-menu-item" @onclick="HandleLogout">
                    <Icon Type="logout" />
                    <span>Sign out</span>
                </div>
            }
            else
            {
                <div class="logout-icon-only" @onclick="HandleLogout" title="Sign out">
                    <Icon Type="logout" Style="color: #94a3b8;" />
                </div>
            }
        </div>
    </Sider>
    <Layout Style="background: #f8fafc;">
        <Header Class="app-header" Style="background: white; padding: 0 24px; height: 64px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e8e8e8;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <Button Type="@ButtonType.Text" OnClick="ToggleCollapse" Style="padding: 4px 8px;">
                    <Icon Type="@GetCollapseIcon()" Style="font-size: 18px; color: #595959;" />
                </Button>
                <span style="font-size: 18px; font-weight: 600; color: #1a1a1a;">The Translation Gate</span>
            </div>
            <div style="display: flex; align-items: center; gap: 16px;">
                <Input TValue="string"
                       Placeholder="Search..."
                       Prefix="@SearchIcon"
                       Size="@InputSize.Default"
                       Style="width: 280px; border-radius: 8px;" />
                <Badge Count="3" Style="cursor: pointer;">
                    <Icon Type="bell" Style="font-size: 20px; color: #595959;" />
                </Badge>
                <div style="cursor: pointer;" @onclick="@(() => NavigateTo("/profile"))">
                    <Avatar Style="background: #3b82f6; font-weight: 500;">SR</Avatar>
                </div>
            </div>
        </Header>
        <Content Style="padding: 24px; background: #f8fafc; min-height: calc(100vh - 64px);">
            @Body
        </Content>
    </Layout>
</Layout>

<div id="blazor-error-ui" data-nosnippet style="display:none;">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x1F5D9;</span>
</div>

@code {
    private bool collapsed = false;
    private UserRole currentUserRole = UserRole.Translator;

    private RenderFragment settingsTitleTemplate => __builder =>
    {
        <span>
            <Icon Type="setting" />
            <span>Settings</span>
        </span>;
    };

    private RenderFragment SearchIcon => __builder =>
    {
        <Icon Type="search" Style="color: #8c8c8c;" />
    };

    private void ToggleCollapse()
    {
        collapsed = !collapsed;
    }

    private string GetCollapseIcon() => collapsed ? "menu-unfold" : "menu-fold";

    private void SetRoleToTranslator()
    {
        currentUserRole = UserRole.Translator;
    }

    private void SetRoleToManager()
    {
        currentUserRole = UserRole.Manager;
    }

    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }

    private async Task HandleLogout()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "token");
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "user");
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private string GetMenuKey()
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        return uri switch
        {
            "" or "dashboard" => "dashboard",
            "tasks" or "my-tasks" => currentUserRole == UserRole.Manager ? "tasks" : "my-tasks",
            "translators" => "translators",
            "users" => "users",
            "reviews" or "my-reviews" => currentUserRole == UserRole.Manager ? "reviews" : "my-reviews",
            "calendar" => "calendar",
            "profile" => "profile",
            _ => "dashboard"
        };
    }

    private string GetPageTitle()
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        return uri switch
        {
            "" or "dashboard" => "Dashboard",
            "tasks" or "my-tasks" => currentUserRole == UserRole.Manager ? "Tasks" : "My Tasks",
            "translators" => "Translators",
            "users" => "Users",
            "reviews" or "my-reviews" => currentUserRole == UserRole.Manager ? "Reviews" : "My Reviews",
            "calendar" => "Calendar",
            "profile" => "Profile",
            _ => "Dashboard"
        };
    }

    private void Logout()
    {
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
    }

    public enum UserRole
    {
        Translator,
        Manager
    }
}
