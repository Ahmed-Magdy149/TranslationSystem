@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using TMS.Core.Enums

<Layout Style="min-height: 100vh; background: #f8fafc;">
    <Sidebar @bind-Collapsed="collapsed"
             @bind-CurrentRole="currentUserRole"
             OnLogout="HandleLogout" />

    <Layout Style="background: #f8fafc;">
        <TopNav PageTitle="@GetPageTitle()"
                PageSubtitle="@GetPageSubtitle()"
                OnToggleSidebar="ToggleSidebar" />

        <Content Style="padding: 24px; background: #f8fafc;">
            @Body
        </Content>

        <div class="app-footer">
            <div class="footer-inner">
                <div class="footer-status">
                    <Icon Type="check-circle" Class="status-icon" />
                    <span>System Operational</span>
                </div>
                <div class="footer-copy">
                    The Translation Gate &copy; @DateTime.Now.Year
                </div>
            </div>
        </div>
    </Layout>
</Layout>

<div id="blazor-error-ui" data-nosnippet style="display:none;">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x1F5D9;</span>
</div>

@code {
    private bool collapsed = false;
    private UserRole currentUserRole = UserRole.Translator;
    private bool isAuthenticated = false;
    private bool hasCheckedAuth = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !hasCheckedAuth)
        {
            hasCheckedAuth = true;
            await LoadUserRoleFromStorage();
            if (!isAuthenticated)
            {
                var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
                if (currentPath != "login" && currentPath != "")
                {
                    Navigation.NavigateTo("/login");
                }
            }
        }
    }

    private async Task LoadUserRoleFromStorage()
    {
        try
        {
            var userJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "user");
            if (!string.IsNullOrEmpty(userJson))
            {
                var user = System.Text.Json.JsonSerializer.Deserialize<TopNav.UserInfo>(userJson);
                if (user != null && !string.IsNullOrEmpty(user.Role))
                {
                    if (Enum.TryParse<UserRole>(user.Role, out var role))
                    {
                        currentUserRole = role;
                        isAuthenticated = true;
                    }
                }
            }
        }
        catch { }
    }

    private void ToggleSidebar()
    {
        collapsed = !collapsed;
    }

    private async Task HandleLogout()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.clear");
        isAuthenticated = false;
        currentUserRole = UserRole.Translator;
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private string GetPageTitle()
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        var isManager = currentUserRole == UserRole.Admin || currentUserRole == UserRole.Manager || currentUserRole == UserRole.ProjectManager || currentUserRole == UserRole.TeamLeader;
        return uri switch
        {
            "" or "dashboard" => "Dashboard",
            "tasks" or "my-tasks" => isManager ? "Tasks" : "My Tasks",
            "translators" => "Translators",
            "users" => "Users",
            "reviews" or "my-reviews" => isManager ? "Reviews" : "My Reviews",
            "calendar" => "Calendar",
            "profile" => "Profile",
            "change-password" => "Change Password",
            "notifications" => "Notifications",
            "reports" => "Reports",
            _ => "Dashboard"
        };
    }

    private string GetPageSubtitle()
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        return uri switch
        {
            "" or "dashboard" => "Welcome back! Here's what's happening today.",
            "tasks" or "my-tasks" => "Manage and track translation tasks",
            "translators" => "Translator directory and assignments",
            "users" => "User management and permissions",
            "reviews" or "my-reviews" => "Quality reviews and feedback",
            "calendar" => "Schedule and availability",
            "profile" => "Your personal information",
            "change-password" => "Update your security credentials",
            "notifications" => "Manage your notification preferences",
            _ => "Welcome back"
        };
    }
}
