@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<Layout Style="min-height: 100vh; background: #f8fafc;">
    <Sidebar @bind-Collapsed="collapsed"
             @bind-CurrentRole="currentUserRole"
             OnLogout="HandleLogout" />

    <Layout Style="background: #f8fafc;">
        <TopNav PageTitle="@GetPageTitle()"
                PageSubtitle="@GetPageSubtitle()"
                UserName="Sarah Reed"
                UserInitials="SR"
                UserRole="Project Manager"
                OnToggleSidebar="ToggleSidebar" />

        <Content Style="padding: 24px; background: #f8fafc;">
            @Body
        </Content>

        <div class="app-footer">
            <div class="footer-inner">
                <div class="footer-status">
                    <Icon Type="check-circle" Class="status-icon" />
                    <span>System Operational</span>
                </div>
                <div class="footer-copy">
                    The Translation Gate &copy; @DateTime.Now.Year
                </div>
            </div>
        </div>
    </Layout>
</Layout>

<div id="blazor-error-ui" data-nosnippet style="display:none;">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x1F5D9;</span>
</div>

@code {
    private bool collapsed = false;
    private Sidebar.UserRole currentUserRole = Sidebar.UserRole.Translator;

    private void ToggleSidebar()
    {
        collapsed = !collapsed;
    }

    private async Task HandleLogout()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.clear");
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private string GetPageTitle()
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        return uri switch
        {
            "" or "dashboard" => "Dashboard",
            "tasks" or "my-tasks" => currentUserRole == Sidebar.UserRole.Manager ? "Tasks" : "My Tasks",
            "translators" => "Translators",
            "users" => "Users",
            "reviews" or "my-reviews" => currentUserRole == Sidebar.UserRole.Manager ? "Reviews" : "My Reviews",
            "calendar" => "Calendar",
            "profile" => "Profile",
            "change-password" => "Change Password",
            "notifications" => "Notifications",
            _ => "Dashboard"
        };
    }

    private string GetPageSubtitle()
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        return uri switch
        {
            "" or "dashboard" => "Welcome back! Here's what's happening today.",
            "tasks" or "my-tasks" => "Manage and track translation tasks",
            "translators" => "Translator directory and assignments",
            "users" => "User management and permissions",
            "reviews" or "my-reviews" => "Quality reviews and feedback",
            "calendar" => "Schedule and availability",
            "profile" => "Your personal information",
            "change-password" => "Update your security credentials",
            "notifications" => "Manage your notification preferences",
            _ => "Welcome back"
        };
    }
}
