@page "/dashboard"
@rendermode InteractiveServer
@using TMS.Web.Models.ViewModels

<PageTitle>Dashboard - The Translation Gate</PageTitle>

<PageContainer>
    <!-- Page Header -->
    <AppPageHeader Title="Dashboard"
                   Subtitle="Welcome back! Here's what's happening today.">
        <Actions>
            <Button Type="ButtonType.Primary" Icon="plus" OnClick="@(() => Navigation.NavigateTo("/tasks"))">
                New Task
            </Button>
        </Actions>
    </AppPageHeader>

    <!-- Stat Cards -->
    <div class="dash-stats-grid">
        @foreach (var stat in statCards)
        {
            <Card Bordered="false" Class="tms-card-stat">
                <div class="dash-stat-inner">
                    <div>
                        <div class="dash-stat-label">@stat.Label</div>
                        <div class="dash-stat-value">@stat.Value</div>
                        <div class="dash-stat-trend @(stat.IsPositive ? "trend-up" : "trend-down")">
                            <Icon Type="@GetTrendIcon(stat.IsPositive)" />
                            @stat.Trend
                        </div>
                    </div>
                    <div class="tms-card-icon" style="background: @stat.IconBg; color: @stat.IconColor;">
                        <Icon Type="@stat.Icon" />
                    </div>
                </div>
            </Card>
        }
    </div>

    <!-- Metrics Row -->
    <div class="dash-metrics-grid">
        @foreach (var metric in metrics)
        {
            <Card Bordered="false">
                <div class="dash-metric-header">
                    <span class="dash-metric-label">@metric.Label</span>
                    <div class="tms-card-icon" style="width: 32px; height: 32px; font-size: 14px; background: @metric.IconBg; color: @metric.IconColor;">
                        <Icon Type="@metric.Icon" />
                    </div>
                </div>
                <div class="dash-metric-value">@metric.Value</div>
                <Progress Percent="@metric.Percentage" ShowInfo="false" StrokeColor="@metric.BarColor" TrailColor="#f1f5f9" Size="ProgressSize.Small" Style="margin-top: 10px;" />
            </Card>
        }
    </div>

    <!-- Chart Section -->
    <Card Bordered="false" Class="tms-section">
        <div class="dash-chart-header">
            <div>
                <div style="font-size: 15px; font-weight: 700; color: var(--tms-text-primary); margin-bottom: 2px;">Monthly Productivity</div>
                <div style="font-size: 13px; color: var(--tms-text-secondary);">Translation words completed vs. target</div>
            </div>
            <div class="dash-chart-legend">
                <span class="dash-legend-item">
                    <span class="dash-legend-dot" style="background: var(--tms-primary);"></span>
                    Words
                </span>
                <span class="dash-legend-item">
                    <span class="dash-legend-dot" style="background: #9333ea;"></span>
                    QA Score
                </span>
            </div>
        </div>
        <div class="dash-chart">
            @foreach (var item in chartData)
            {
                <div class="dash-chart-col">
                    <Tooltip Title="@($"{item.Words:N0} words")">
                        <div class="dash-chart-bar" style="height: @(item.Height)%;"></div>
                    </Tooltip>
                    <span class="dash-chart-month">@item.Month</span>
                </div>
            }
        </div>
    </Card>

    <!-- Bottom Row -->
    <div class="dash-bottom-grid">
        <!-- Recent Activity -->
        <Card Bordered="false" Title="Recent Activity" Extra="@activityExtra">
            @foreach (var act in recentActivity)
            {
                <div class="dash-activity-row">
                    <div class="dash-activity-avatar" style="background: @act.AvatarBg; color: @act.AvatarColor;">
                        @act.Initials
                    </div>
                    <div class="dash-activity-text">
                        <div class="dash-activity-desc">@(new MarkupString(act.Description))</div>
                        <div class="dash-activity-time">@act.Time</div>
                    </div>
                </div>
            }
        </Card>

        <!-- Upcoming Deadlines -->
        <Card Bordered="false" Title="Upcoming Deadlines" Extra="@deadlineExtra">
            @foreach (var dl in upcomingDeadlines)
            {
                <div class="dash-deadline-row">
                    <div class="tms-card-icon" style="width: 40px; height: 40px; font-size: 16px; background: @dl.IconBg; color: @dl.IconColor;">
                        <Icon Type="@dl.Icon" />
                    </div>
                    <div class="dash-deadline-info">
                        <div class="dash-deadline-title">@dl.Title</div>
                        <div class="dash-deadline-meta">@dl.Meta</div>
                    </div>
                    <Tag Color="@GetDeadlineColor(dl.TagClass)">@dl.DueText</Tag>
                </div>
            }
        </Card>
    </div>
</PageContainer>

@code {
    private RenderFragment activityExtra =
        @<Template>
            <Button Type="ButtonType.Link" Size="ButtonSize.Small">View all</Button>
        </Template>;

    private RenderFragment deadlineExtra =
        @<Template>
            <Button Type="ButtonType.Link" Size="ButtonSize.Small">View all</Button>
        </Template>;

    private string GetTrendIcon(bool isPositive) => isPositive ? "arrow-up" : "arrow-down";

    private string GetDeadlineColor(string tagClass) => tagClass switch
    {
        "tag-urgent" => "error",
        "tag-soon" => "warning",
        _ => "success"
    };
}
