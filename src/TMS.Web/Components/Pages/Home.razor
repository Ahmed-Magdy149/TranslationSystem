@page "/dashboard"
@rendermode InteractiveServer
@using TMS.Web.Models.ViewModels

<PageTitle>Dashboard - The Translation Gate</PageTitle>

<div style="display: flex; flex-direction: column; gap: 16px; width: 100%;">
    <!-- Welcome Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <TypographyTitle Level="3" Style="margin: 0;">Dashboard</TypographyTitle>
            <TypographyText Type="TextType.Secondary">Welcome back! Here's what's happening today.</TypographyText>
        </div>
        <Button Type="@ButtonType.Primary" Icon="plus" OnClick="@(() => Navigation.NavigateTo("/tasks"))">
            New Task
        </Button>
    </div>

    <!-- Stat Cards -->
    <div class="stats-grid">
        @foreach (var stat in statCards)
        {
            <Card Bordered="false" Hoverable Class="dashboard-stat-card">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <div>
                        <TypographyText Type="TextType.Secondary" Style="font-size: 13px;">@stat.Label</TypographyText>
                        <br />
                        <Statistic Value="@stat.Value" ValueStyle="font-size: 28px; font-weight: 700; color: #262626;" />
                        <TypographyText Style="font-size: 13px; color: @(stat.IsPositive ? "#52c41a" : "#ff4d4f");">
                            <Icon Type="@GetTrendIcon(stat.IsPositive)" /> @stat.Trend
                        </TypographyText>
                    </div>
                    <div style="width: 48px; height: 48px; border-radius: 8px; background: @stat.IconBg; color: @stat.IconColor; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                        <Icon Type="@stat.Icon" />
                    </div>
                </div>
            </Card>
        }
    </div>

    <!-- Metrics Row -->
    <div class="metrics-grid">
        @foreach (var metric in metrics)
        {
            <Card Bordered="false" Class="dashboard-metric-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <TypographyText Type="TextType.Secondary" Style="font-size: 12px; text-transform: uppercase;">@metric.Label</TypographyText>
                    <div style="width: 32px; height: 32px; border-radius: 6px; background: @metric.IconBg; color: @metric.IconColor; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                        <Icon Type="@metric.Icon" />
                    </div>
                </div>
                <TypographyTitle Level="4" Style="margin: 0;">@metric.Value</TypographyTitle>
                <Progress Percent="@metric.Percentage" ShowInfo="false" StrokeColor="@metric.BarColor" TrailColor="#f0f0f0" Size="ProgressSize.Small" Style="margin-top: 12px;" />
            </Card>
        }
    </div>

    <!-- Chart Section -->
    <Card Bordered="false" Class="dashboard-chart-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
            <div>
                <TypographyTitle Level="5" Style="margin: 0;">Monthly Productivity</TypographyTitle>
                <TypographyText Type="TextType.Secondary" Style="font-size: 13px;">Translation words completed vs. target</TypographyText>
            </div>
            <div style="display: flex; gap: 16px; font-size: 13px; color: #64748b;">
                <span style="display: flex; align-items: center; gap: 6px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #1890ff; display: inline-block;"></span>
                    Words
                </span>
                <span style="display: flex; align-items: center; gap: 6px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #722ed1; display: inline-block;"></span>
                    QA Score
                </span>
            </div>
        </div>
        <div class="chart-container">
            @foreach (var item in chartData)
            {
                <div class="chart-column">
                    <Tooltip Title="@($"{item.Words:N0} words")">
                        <div class="chart-bar" style="height: @(item.Height)%;"></div>
                    </Tooltip>
                    <TypographyText Type="TextType.Secondary" Style="font-size: 12px;">@item.Month</TypographyText>
                </div>
            }
        </div>
    </Card>

    <!-- Bottom Row -->
    <div class="bottom-grid">
        <!-- Recent Activity -->
        <Card Bordered="false" Title="Recent Activity" Extra="@activityExtra" Class="dashboard-panel-card">
            @foreach (var act in recentActivity)
            {
                <div style="display: flex; align-items: flex-start; gap: 12px; padding: 12px 0; border-bottom: 1px solid #f0f0f0;">
                    <div style="width: 36px; height: 36px; border-radius: 50%; background: @act.AvatarBg; color: @act.AvatarColor; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 600; flex-shrink: 0;">
                        @act.Initials
                    </div>
                    <div>
                        <TypographyText Style="font-size: 14px;">@(new MarkupString(act.Description))</TypographyText>
                        <br />
                        <TypographyText Type="TextType.Secondary" Style="font-size: 12px;">@act.Time</TypographyText>
                    </div>
                </div>
            }
        </Card>

        <!-- Upcoming Deadlines -->
        <Card Bordered="false" Title="Upcoming Deadlines" Extra="@deadlineExtra" Class="dashboard-panel-card">
            @foreach (var dl in upcomingDeadlines)
            {
                <div style="display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #f0f0f0;">
                    <div style="width: 40px; height: 40px; border-radius: 8px; background: @dl.IconBg; color: @dl.IconColor; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0;">
                        <Icon Type="@dl.Icon" />
                    </div>
                    <div style="flex: 1;">
                        <TypographyText Style="font-weight: 500; font-size: 14px;">@dl.Title</TypographyText>
                        <br />
                        <TypographyText Type="TextType.Secondary" Style="font-size: 12px;">@dl.Meta</TypographyText>
                    </div>
                    <Tag Color="@GetDeadlineColor(dl.TagClass)">@dl.DueText</Tag>
                </div>
            }
        </Card>
    </div>
</div>

@code {
    private RenderFragment activityExtra =
        @<Template>
            <Button Type="ButtonType.Link" Size="ButtonSize.Small">View all</Button>
        </Template>;

    private RenderFragment deadlineExtra =
        @<Template>
            <Button Type="ButtonType.Link" Size="ButtonSize.Small">View all</Button>
        </Template>;

    private string GetTrendIcon(bool isPositive) => isPositive ? "arrow-up" : "arrow-down";

    private string GetDeadlineColor(string tagClass) => tagClass switch
    {
        "tag-urgent" => "error",
        "tag-soon" => "warning",
        _ => "success"
    };
}
