@page "/users"
@rendermode InteractiveServer
@using TMS.Core.DTOs
@using TMS.Core.Enums

<PageTitle>Users - TMS</PageTitle>

<Space Direction="SpaceDirection.Vertical" Size="SpaceSize.Middle" Style="width: 100%;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <TypographyTitle Level="3" Style="margin: 0;">Users Management</TypographyTitle>
            <TypographyText Type="TextType.Secondary">Manage team members and their roles</TypographyText>
        </div>
        <Button Type="@ButtonType.Primary" Icon="plus" Size="@ButtonSize.Large" OnClick="ShowAddModal">
            Add New User
        </Button>
    </div>

    <!-- Stats Summary -->
    <Row Gutter="16">
        <Col Span="6" Xs="12" Lg="6">
            <Card Bordered="false" Class="users-stat-card">
                <Statistic Title="Total Users" Value="@users.Count" ValueStyle="color: #1890ff;" />
            </Card>
        </Col>
        <Col Span="6" Xs="12" Lg="6">
            <Card Bordered="false" Class="users-stat-card">
                <Statistic Title="Active" Value="@users.Count(u => u.IsActive)" ValueStyle="color: #52c41a;" />
            </Card>
        </Col>
        <Col Span="6" Xs="12" Lg="6">
            <Card Bordered="false" Class="users-stat-card">
                <Statistic Title="Inactive" Value="@users.Count(u => !u.IsActive)" ValueStyle="color: #ff4d4f;" />
            </Card>
        </Col>
        <Col Span="6" Xs="12" Lg="6">
            <Card Bordered="false" Class="users-stat-card">
                <Statistic Title="Admins" Value="@users.Count(u => u.Role == UserRole.Admin)" ValueStyle="color: #faad14;" />
            </Card>
        </Col>
    </Row>

    <!-- Users Table -->
    <Card Bordered="false" Class="users-table-card" Title="All Users">
        <Table DataSource="@users" Loading="@loading" TItem="UserDto" RowKey="x => x.Id">
            <Column Title="Name" @bind-Field="@context.Name" Sortable>
                <Space>
                    <SpaceItem>
                        <Avatar Style="background: #1890ff;">
                            @context.Name?.Substring(0, 1).ToUpper()
                        </Avatar>
                    </SpaceItem>
                    <SpaceItem>
                        <TypographyText Strong>@context.Name</TypographyText>
                    </SpaceItem>
                </Space>
            </Column>
            <Column Title="Email" @bind-Field="@context.Email" />
            <Column Title="Role" @bind-Field="@context.Role">
                <Tag Color="@GetRoleColor(context.Role.ToString())">@context.Role.ToString()</Tag>
            </Column>
            <Column Title="Status" @bind-Field="@context.IsActive">
                <Badge Status="@(context.IsActive ? BadgeStatus.Success : BadgeStatus.Error)" Text="@(context.IsActive ? "Active" : "Inactive")" />
            </Column>
            <Column Title="Created" @bind-Field="@context.CreatedAt">
                @context.CreatedAt.ToString("yyyy-MM-dd")
            </Column>
            <ActionColumn Title="Actions" Width="150">
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" Ghost Icon="edit" Size="@ButtonSize.Small" OnClick="() => ShowEditModal(context)">Edit</Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Popconfirm Title="Are you sure you want to delete this user?"
                                    OnConfirm="() => DeleteUser(context.Id)"
                                    OkText="Yes"
                                    CancelText="No">
                            <Button Type="@ButtonType.Primary" Danger Icon="delete" Size="@ButtonSize.Small">Delete</Button>
                        </Popconfirm>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </Table>
    </Card>
</Space>

<Modal Title="@(isEditMode ? "Edit User" : "Add New User")"
       @bind-Visible="@modalVisible"
       OnOk="HandleSubmit"
       OnCancel="HandleCancel"
       OkText="@(isEditMode ? "Update" : "Create")"
       Width="600">
    <Form Model="@currentUser" Layout="@FormLayout.Vertical">
        <FormItem Label="Name">
            <Input @bind-Value="@currentUser.Name" Placeholder="Enter user name" Size="@InputSize.Large" />
        </FormItem>
        <FormItem Label="Email">
            <Input @bind-Value="@currentUser.Email" Placeholder="Enter email address" Size="@InputSize.Large" />
        </FormItem>
        @if (!isEditMode)
        {
            <FormItem Label="Password">
                <InputPassword @bind-Value="@currentUser.Password" Placeholder="Enter password" Size="@InputSize.Large" />
            </FormItem>
        }
        <FormItem Label="Role">
            <Select @bind-Value="@currentUser.Role" TItemValue="UserRole" TItem="UserRole" Placeholder="Select role" Size="@InputSize.Large">
                <SelectOption TItemValue="UserRole" TItem="UserRole" Value="@UserRole.Admin" Label="Admin" />
                <SelectOption TItemValue="UserRole" TItem="UserRole" Value="@UserRole.Manager" Label="Manager" />
                <SelectOption TItemValue="UserRole" TItem="UserRole" Value="@UserRole.Translator" Label="Translator" />
            </Select>
        </FormItem>
        <FormItem Label="Status">
            <Switch @bind-Value="@currentUser.IsActive" CheckedChildren="Active" UnCheckedChildren="Inactive" />
        </FormItem>
    </Form>
</Modal>

