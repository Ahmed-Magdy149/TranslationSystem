@page "/"
@page "/login"
@rendermode InteractiveServer
@layout TMS.Web.Components.Layout.EmptyLayout

<PageTitle>Login - The Translation Gate</PageTitle>

<div class="login-split">
    <!-- Left Side -->
    <div class="login-left">
        <div class="login-brand">
            <Avatar Shape="AvatarShape.Square" Size="@AvatarSize.Large" Style="background: rgba(255,255,255,0.2); border-radius: 8px;">
                <Icon Type="global" Style="font-size: 24px; color: white;" />
            </Avatar>
            <TypographyTitle Level="4" Style="color: white; margin: 0;">The Translation Gate</TypographyTitle>
        </div>

        <div class="login-left-content">
            <TypographyTitle Level="1" Style="color: white; margin: 0 0 16px 0; font-size: 36px; font-weight: 700;">
                Your global translation hub
            </TypographyTitle>
            <TypographyText Style="color: rgba(255,255,255,0.85); font-size: 16px; line-height: 1.6;">
                Manage projects, coordinate translators, track quality, and deliver on time — all in one powerful platform.
            </TypographyText>

            <Row Gutter="32" Style="margin-top: 40px;">
                <Col>
                    <div style="text-align: center;">
                        <TypographyTitle Level="3" Style="color: white; margin: 0;">500K+</TypographyTitle>
                        <TypographyText Style="color: rgba(255,255,255,0.7); font-size: 13px;">Words/month</TypographyText>
                    </div>
                </Col>
                <Col>
                    <div style="text-align: center;">
                        <TypographyTitle Level="3" Style="color: white; margin: 0;">98%</TypographyTitle>
                        <TypographyText Style="color: rgba(255,255,255,0.7); font-size: 13px;">QA score</TypographyText>
                    </div>
                </Col>
                <Col>
                    <div style="text-align: center;">
                        <TypographyTitle Level="3" Style="color: white; margin: 0;">50+</TypographyTitle>
                        <TypographyText Style="color: rgba(255,255,255,0.7); font-size: 13px;">Languages</TypographyText>
                    </div>
                </Col>
            </Row>
        </div>

        <TypographyText Style="color: rgba(255,255,255,0.6); font-size: 12px;">
            2025 The Translation Gate. All rights reserved.
        </TypographyText>
    </div>

    <!-- Right Side -->
    <div class="login-right">
        <Card Bordered="false" Style="width: 100%; max-width: 400px; box-shadow: 0 8px 24px rgba(0,0,0,0.08); border-radius: 16px;" Class="login-card">
            <TypographyTitle Level="3" Style="margin: 0 0 8px 0;">Welcome back</TypographyTitle>
            <TypographyText Type="TextType.Secondary" Style="font-size: 14px;">Sign in to your workspace</TypographyText>

            <Form Model="@loginModel" Layout="FormLayout.Vertical" Style="margin-top: 24px;">
                <FormItem Label="Email Address">
                    <Input Placeholder="you@company.com" @bind-Value="@loginModel.Email" Size="@InputSize.Large" />
                </FormItem>

                <FormItem Label="Password">
                    <InputPassword Placeholder="Enter your password" @bind-Value="@loginModel.Password" Size="@InputSize.Large" />
                </FormItem>

                <FormItem>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <Checkbox @bind-Value="@rememberMe">Remember me for 30 days</Checkbox>
                        <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" Style="padding: 0;">Forgot password?</Button>
                    </div>
                </FormItem>

                <FormItem>
                    <Button Type="@ButtonType.Primary" Block Size="@ButtonSize.Large" OnClick="HandleLogin" Loading="@loading">
                        @if (!loading)
                        {
                            <Space>
                                <span>Sign in</span>
                                <Icon Type="arrow-right" />
                            </Space>
                        }
                    </Button>
                </FormItem>
            </Form>

            <Alert Message="Demo credentials pre-filled — just click Sign in" Type="AlertType.Info" ShowIcon="true" Style="margin-top: 16px;" />
        </Card>
    </div>
</div>

